# Single-device build for Xiaomi Redmi AX5400 RA74 only.
# Deliberately omit CONFIG_TARGET_MULTI_PROFILE and all other device profiles.
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq50xx=y
CONFIG_TARGET_qualcommax_ipq50xx_DEVICE_xiaomi_redmi-ax5400=y

# 512 MB RA74: use the validated 1G ath11k / medium NSS memory profile.
CONFIG_ATH11K_MEM_PROFILE_1G=y
CONFIG_NSS_MEM_PROFILE_MEDIUM=y

# NSS firmware and wired datapath.
CONFIG_PACKAGE_nss-tools-dwmac=y
CONFIG_PACKAGE_nss-firmware=y
CONFIG_NSS_FIRMWARE_VERSION_12_5=y
CONFIG_NSS_DRV_VLAN_ENABLE=y
CONFIG_NSS_DRV_IPV6_ENABLE=y
CONFIG_NSS_DRV_PPPOE_ENABLE=y
CONFIG_NSS_DRV_VIRT_IF_ENABLE=y
CONFIG_PACKAGE_kmod-ppp=y
CONFIG_PACKAGE_kmod-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-netlink=y
CONFIG_PACKAGE_nssinfo=y
CONFIG_PACKAGE_libnl-nss=y

# Full wpad-mbedtls is required for 802.11v (CONFIG_WNM) / bss_transition.
# Do not use wpad-basic-mbedtls: its hostapd build disables WNM.
CONFIG_PACKAGE_wpad-mbedtls=y

# ath11k + NSS Wi-Fi offload and ath11k thermal reporting/throttling.
CONFIG_ATH11K_THERMAL=y
CONFIG_PACKAGE_MAC80211_NSS_SUPPORT=y
CONFIG_ATH11K_NSS_SUPPORT=y
CONFIG_NSS_DRV_WIFIOFFLOAD_ENABLE=y
CONFIG_NSS_DRV_WIFI_EXT_VDEV_ENABLE=y
CONFIG_PACKAGE_ATH_DEBUG=y

# NSS shaper / IGS / SQM support.
CONFIG_NSS_DRV_SHAPER_ENABLE=y
CONFIG_NSS_DRV_IGS_ENABLE=y
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y
CONFIG_PACKAGE_kmod-qca-nss-drv-igs=y
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_sqm-scripts-nss=y
CONFIG_PACKAGE_tc-full=y

# Useful diagnostics.
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_dumpimage=y

# LuCI language selection; RA74 DEVICE_PACKAGES adds LuCI, Chinese base
# translation, NSS status app, and its Chinese translation to this image.
CONFIG_PACKAGE_luci-app-nss=m
CONFIG_LUCI_LANG_zh_Hans=y

# Build metadata and cache.
CONFIG_KERNEL_BUILD_DOMAIN="openwrt-nss-edma"
CONFIG_KERNEL_BUILD_USER="Eddiks"
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_AUTOREMOVE=y

# Deployment build must not include the temporary bring-up debug facilities.
# The workflow also checks that these remain disabled after defconfig.
# CONFIG_MAGIC_SYSRQ_SERIAL is not set
# CONFIG_DEVMEM is not set
